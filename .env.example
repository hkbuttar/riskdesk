# Root directory containing the six sibling repos (alpha-signal-lab,
# streamalpha, bookmaker, execedge, pairtrade-lab-1, voledge) as direct
# subdirectories. Defaults to the home directory if unset -- see
# connectors/_env.py. Connectors read each sibling repo's OWN .env file for
# credentials (e.g. DATABASE_URL); riskdesk does not duplicate secrets here.
RISKDESK_SIBLINGS_ROOT=/Users/hkbuttar

# Alpaca Market Data. RiskDesk also checks alpha-signal-lab/.env for these
# credentials, but explicit local values are recommended for deployment.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_STOCK_FEED=iex

# Frontend build-time FastAPI URL. Use the deployed Render URL in Vercel.
RISKDESK_API_URL=http://127.0.0.1:8000
